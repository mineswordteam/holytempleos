public CBGR24 gr_palette_slate[COLORS_NUM] = {
0x1B1B3A, 0x2F5BD8, 0x14935A, 0x0E8FA8, 0xD3304A, 0x7A3FD1, 0xC27A0E, 0xD9DEEE, 0x6A7396, 0x5B8CFF, 0x45CF85, 0x45C8E0, 0xFF6A80, 0xA57CFF, 0xFFC53D, 0xF7F9FF
};
public U0 PaletteSetSlate(Bool persistent=TRUE)
{
	GrPaletteSet(gr_palette_slate);
	LFBFlush;
	if (persistent)
		fp_set_std_palette = &PaletteSetSlate;
}