// Holy TempleOS Launcher v5 - by Minesword Team (based on TempleOS)
// Desktop (cannot be closed) + app windows (move, resize, maximize, close) + optional PIN lock.
CBGR24 hl_pal_bright[16] = {0x1B1B3A, 0x2F5BD8, 0x14935A, 0x0E8FA8, 0xD3304A, 0x7A3FD1, 0xC27A0E, 0xD9DEEE,
	0x6A7396, 0x5B8CFF, 0x45CF85, 0x45C8E0, 0xFF6A80, 0xA57CFF, 0xFFC53D, 0xF7F9FF};
CBGR24 hl_pal_dark[16] = {0xEDEAFB, 0x7C93FF, 0x5FD79A, 0x4FC3D9, 0xF0627A, 0xB07CF0, 0xE0A03A, 0x2A2750,
	0x4B4690, 0xA9B8FF, 0x9BF0C2, 0x9BE6F2, 0xFF9AA8, 0xD4B0FF, 0xFFD966, 0x14122B};

class HLItem
{
	U8 *label;
	U8 *cmd;
	I64 light;
	I64 dark;
	I64 icon;
	I64 kind;
	I64 arg;
};
class HLPad
{
	U8 entry[8];
	I64 len;
	I64 wrong;
	I64 hover;
	I64 kx[12];
	I64 ky[12];
	I64 ks;
};
HLItem hl_it[3][24];
I64 hl_cnt[3];
I64 hl_hov[3];
HLPad hl_lockpad, hl_setpad;
U8 hl_pin[8];
I64 hl_theme = 0, hl_locked = FALSE, hl_after = 0, hl_setmode = 0;
I64 hl_panel = FALSE, hl_pbhover = -1, hl_pbn = 0;
I64 hl_pbx[4], hl_pby[4], hl_pbw[4], hl_pbh[4];
I64 hl_ox = 0, hl_oy = 0;
I64 hw_x[5], hw_y[5], hw_w[5], hw_h[5], hw_open[5], hw_min[5], hw_max[5], hw_sv[5][4];
I64 hw_z[4], hw_zn = 0, hw_mode = 0, hw_id = 0, hw_dx = 0, hw_dy = 0, hw_edge = 0, hw_pbtn = 0, hw_pid = 0;
I64 hw_over = 0, hw_btn = 0, hw_tb = -1, hl_install_req = FALSE;
I64 hw_ex = 0, hw_ey = 0, hw_ew = 0, hw_eh = 0;
U8 hl_clock[16];
U8 hl_date[24];
U8 hl_plab[16];
U8 hl_notes[4][72];
I64 hl_note_n = 0;

U0 HLNote(U8 *s)
{
	I64 i;
	for (i = 3; i > 0; i--)
		StrCopy(hl_notes[i], hl_notes[i - 1]);
	StrCopy(hl_notes[0], s);
	if (hl_note_n < 4)
		hl_note_n++;
}

U0 HLTheme(I64 t)
{
	hl_theme = t;
	if (t == 0)
		GrPaletteSet(hl_pal_bright);
	else if (t == 1)
		GrPaletteSet(hl_pal_dark);
	else
		GrPaletteSet(gr32_palette_std);
	LFBFlush;
}

U0 HLAdd(I64 k, U8 *label, U8 *cmd, I64 light, I64 dark, I64 icon, I64 kind, I64 arg)
{
	I64 n = hl_cnt[k];
	hl_it[k][n].label = label;
	hl_it[k][n].cmd = cmd;
	hl_it[k][n].light = light;
	hl_it[k][n].dark = dark;
	hl_it[k][n].icon = icon;
	hl_it[k][n].kind = kind;
	hl_it[k][n].arg = arg;
	hl_cnt[k]++;
}

U0 HLPinLoad()
{
	U8 *p;
	hl_pin[0] = 0;
	if (Letter2Drive('C', FALSE) && FileFind("C:/Home/Holy.PIN"))
	{
		p = FileRead("C:/Home/Holy.PIN");
		if (p)
		{
			if (StrLen(p) == 4)
				StrCopy(hl_pin, p);
			Free(p);
		}
	}
}

U0 HLPinSave()
{
	if (Letter2Drive('C', FALSE))
	{
		if (hl_pin[0])
			FileWrite("C:/Home/Holy.PIN", hl_pin, StrLen(hl_pin));
		else if (FileFind("C:/Home/Holy.PIN"))
			Del("C:/Home/Holy.PIN");
	}
}

//SPLIT
U0 HLBig(CDC *dc, I64 x, I64 y, U8 *s, I64 sc, I64 color)
{
	I64 r, c;
	U8 *f = text.font;
	U8 bits;
	dc->color = color;
	while (*s)
	{
		for (r = 0; r < 8; r++)
		{
			bits = f[*s * 8 + r];
			for (c = 0; c < 8; c++)
				if (bits & (1 << c))
					GrRect(dc, hl_ox + x + c * sc, hl_oy + y + r * sc, sc, sc);
		}
		x += 8 * sc;
		s++;
	}
}

I64 HLWidth(U8 *s, I64 sc)
{
	return StrLen(s) * 8 * sc;
}

U0 HLRect(CDC *dc, I64 x, I64 y, I64 w, I64 h, I64 color)
{
	dc->color = color;
	GrRect(dc, hl_ox + x, hl_oy + y, w, h);
}

U0 HLDisc(CDC *dc, I64 cx, I64 cy, I64 r, I64 color)
{
	I64 dy, w;
	dc->color = color;
	for (dy = -r; dy <= r; dy++)
	{
		w = ToI64(Sqrt(ToF64(r * r - dy * dy)));
		GrRect(dc, hl_ox + cx - w, hl_oy + cy + dy, 2 * w + 1, 1);
	}
}

U0 HLTriUp(CDC *dc, I64 cx, I64 top, I64 half, I64 h, I64 color)
{
	I64 i, w;
	dc->color = color;
	for (i = 0; i < h; i++)
	{
		w = half * (i + 1) / h;
		GrRect(dc, hl_ox + cx - w, hl_oy + top + i, 2 * w + 1, 1);
	}
}

U0 HLTriDown(CDC *dc, I64 cx, I64 top, I64 half, I64 h, I64 color)
{
	I64 i, w;
	dc->color = color;
	for (i = 0; i < h; i++)
	{
		w = half * (h - i) / h;
		GrRect(dc, hl_ox + cx - w, hl_oy + top + i, 2 * w + 1, 1);
	}
}

U0 HLTriLeft(CDC *dc, I64 left, I64 cy, I64 half, I64 wd, I64 color)
{
	I64 i, w;
	dc->color = color;
	for (i = 0; i < wd; i++)
	{
		w = half * (i + 1) / wd;
		GrRect(dc, hl_ox + left + i, hl_oy + cy - w, 1, 2 * w + 1);
	}
}

//SPLIT
U0 HLIconB(CDC *dc, I64 id, I64 cx, I64 cy, I64 u, I64 fg, I64 ac)
{
	I64 i, j;
	switch (id)
	{
		case 20: //games: controller
			HLRect(dc, cx - 5 * u, cy - 2 * u, 10 * u, 5 * u, fg);
			HLRect(dc, cx - 3 * u, cy - u, u, 3 * u, ac);
			HLRect(dc, cx - 4 * u, cy, 3 * u, u, ac);
			HLDisc(dc, cx + 2 * u, cy - u / 2, u / 2 + 1, ac);
			HLDisc(dc, cx + 4 * u, cy + u, u / 2 + 1, ac);
			break;
		case 21: //settings: gear
			HLRect(dc, cx - u / 2, cy - 4 * u, u, 8 * u, fg);
			HLRect(dc, cx - 4 * u, cy - u / 2, 8 * u, u, fg);
			HLRect(dc, cx - 3 * u, cy - 3 * u, 2 * u, 2 * u, fg);
			HLRect(dc, cx + u, cy - 3 * u, 2 * u, 2 * u, fg);
			HLRect(dc, cx - 3 * u, cy + u, 2 * u, 2 * u, fg);
			HLRect(dc, cx + u, cy + u, 2 * u, 2 * u, fg);
			HLDisc(dc, cx, cy, 3 * u, fg);
			HLDisc(dc, cx, cy, u + u / 2, ac);
			break;
		case 22: //sun
			HLDisc(dc, cx, cy, 2 * u, fg);
			HLRect(dc, cx - u / 2, cy - 4 * u, u, u, fg);
			HLRect(dc, cx - u / 2, cy + 3 * u, u, u, fg);
			HLRect(dc, cx - 4 * u, cy - u / 2, u, u, fg);
			HLRect(dc, cx + 3 * u, cy - u / 2, u, u, fg);
			HLRect(dc, cx - 3 * u, cy - 3 * u, u, u, fg);
			HLRect(dc, cx + 2 * u, cy - 3 * u, u, u, fg);
			HLRect(dc, cx - 3 * u, cy + 2 * u, u, u, fg);
			HLRect(dc, cx + 2 * u, cy + 2 * u, u, u, fg);
			break;
		case 23: //moon
			HLDisc(dc, cx, cy, 3 * u, fg);
			HLDisc(dc, cx + u + u / 2, cy - u, 3 * u, ac);
			break;
		case 24: //classic
			HLRect(dc, cx - 4 * u, cy - 4 * u, 8 * u, 8 * u, fg);
			HLRect(dc, cx - 3 * u, cy - 3 * u, 6 * u, 6 * u, ac);
			HLRect(dc, cx - 2 * u, cy - 2 * u, 4 * u, 4 * u, fg);
			break;
		case 25: //padlock
			HLRect(dc, cx - 2 * u, cy - 4 * u, 4 * u + 1, u / 2 + 1, fg);
			HLRect(dc, cx - 2 * u, cy - 4 * u, u / 2 + 1, 4 * u, fg);
			HLRect(dc, cx + 2 * u, cy - 4 * u, u / 2 + 1, 4 * u, fg);
			HLRect(dc, cx - 3 * u, cy - u, 6 * u + 1, 5 * u, fg);
			HLDisc(dc, cx, cy + u, u / 2 + 1, ac);
			HLRect(dc, cx - u / 4, cy + u, u / 2 + 1, 2 * u, ac);
			break;
		case 26: //wifi bars
			HLRect(dc, cx - 4 * u, cy + 2 * u, 2 * u, 2 * u, fg);
			HLRect(dc, cx - u, cy - u, 2 * u, 5 * u, fg);
			HLRect(dc, cx + 2 * u, cy - 4 * u, 2 * u, 8 * u, fg);
			break;
		case 27: //bluetooth
			HLBig(dc, cx - 4 * u, cy - 4 * u, "B", u, fg);
			break;
		case 28: //globe
			HLDisc(dc, cx, cy, 4 * u, fg);
			HLRect(dc, cx - 4 * u, cy - u / 2, 8 * u, u / 2 + 1, ac);
			HLRect(dc, cx - u / 4, cy - 4 * u, u / 2 + 1, 8 * u, ac);
			HLRect(dc, cx - 3 * u, cy - 2 * u, 6 * u, u / 2 + 1, ac);
			HLRect(dc, cx - 3 * u, cy + 2 * u, 6 * u, u / 2 + 1, ac);
			break;
		case 29: //back
			HLTriLeft(dc, cx - 4 * u, cy, 4 * u, 4 * u, fg);
			HLRect(dc, cx, cy - u, 4 * u, 2 * u, fg);
			break;
		case 30: //power
			HLDisc(dc, cx, cy, 4 * u, fg);
			HLDisc(dc, cx, cy, 3 * u, ac);
			HLRect(dc, cx - u / 2, cy - 5 * u, u, 5 * u, fg);
			break;
		case 31: //bell
			HLDisc(dc, cx, cy - u, 3 * u, fg);
			HLRect(dc, cx - 3 * u, cy - u, 6 * u + 1, 3 * u, fg);
			HLRect(dc, cx - 4 * u, cy + 2 * u, 8 * u + 1, u, fg);
			HLDisc(dc, cx, cy + 3 * u + u / 2, u / 2 + 1, fg);
			break;
		case 32: //folder
			HLRect(dc, cx - 5 * u, cy - 3 * u, 4 * u, u, fg);
			HLRect(dc, cx - 5 * u, cy - 2 * u, 10 * u, 6 * u, fg);
			HLRect(dc, cx - 5 * u, cy - u, 10 * u, u / 2 + 1, ac);
			break;
		case 33: //file
			HLRect(dc, cx - 3 * u, cy - 4 * u, 6 * u, 8 * u, fg);
			HLRect(dc, cx - 2 * u, cy - u, 4 * u, u / 2 + 1, ac);
			HLRect(dc, cx - 2 * u, cy + u, 4 * u, u / 2 + 1, ac);
			HLRect(dc, cx - 2 * u, cy + 3 * u, 3 * u, u / 2 + 1, ac);
			break;
	}
}

U0 HLIcon(CDC *dc, I64 id, I64 cx, I64 cy, I64 u, I64 fg, I64 ac)
{
	I64 i, j;
	switch (id)
	{
		case 0:
			HLRect(dc, cx - u, cy - 4 * u, 2 * u, 3 * u, fg);
			HLTriDown(dc, cx, cy - u, 3 * u, 3 * u, fg);
			HLRect(dc, cx - 4 * u, cy + 3 * u, 8 * u, u, fg);
			HLRect(dc, cx - 4 * u, cy + 2 * u, u, 2 * u, fg);
			HLRect(dc, cx + 3 * u, cy + 2 * u, u, 2 * u, fg);
			break;
		case 1:
			HLTriUp(dc, cx, cy - 4 * u, 5 * u, 4 * u, fg);
			HLRect(dc, cx - 3 * u, cy, 6 * u, 4 * u, fg);
			HLRect(dc, cx - u, cy + u, 2 * u, 3 * u, ac);
			break;
		case 2:
			HLBig(dc, cx - 4 * u, cy - 5 * u, "?", u, fg);
			break;
		case 3:
			HLRect(dc, cx - 5 * u, cy - 4 * u, 10 * u, 8 * u, fg);
			HLRect(dc, cx - 4 * u, cy - 3 * u, 8 * u, 6 * u, ac);
			HLBig(dc, cx - 4 * u, cy - 2 * u, ">_", u / 2 + 1, fg);
			break;
		case 4:
			for (i = 0; i < 4; i++)
				for (j = 0; j < 4; j++)
				{
					if ((i + j) % 2)
						HLRect(dc, cx - 4 * u + i * 2 * u, cy - 4 * u + j * 2 * u, 2 * u, 2 * u, ac);
					else
						HLRect(dc, cx - 4 * u + i * 2 * u, cy - 4 * u + j * 2 * u, 2 * u, 2 * u, fg);
				}
			break;
		case 5:
			HLRect(dc, cx - u, cy - 4 * u, u / 2 + 1, 8 * u, fg);
			HLRect(dc, cx + u, cy - 4 * u, u / 2 + 1, 8 * u, fg);
			HLRect(dc, cx - 4 * u, cy - u, 8 * u, u / 2 + 1, fg);
			HLRect(dc, cx - 4 * u, cy + u, 8 * u, u / 2 + 1, fg);
			for (i = 0; i < 2 * u; i++)
			{
				HLRect(dc, cx - 4 * u + i, cy - 4 * u + i, u / 2 + 1, u / 2 + 1, fg);
				HLRect(dc, cx - 2 * u - i, cy - 4 * u + i, u / 2 + 1, u / 2 + 1, fg);
			}
			HLDisc(dc, cx + 3 * u, cy + 3 * u, u, fg);
			HLDisc(dc, cx + 3 * u, cy + 3 * u, u / 2, ac);
			break;
		case 6:
			HLTriUp(dc, cx, cy - 4 * u, 4 * u, 8 * u, fg);
			HLRect(dc, cx - u / 2, cy + 3 * u, u, 2 * u, fg);
			HLRect(dc, cx - u / 2, cy - 2 * u, u, 4 * u, ac);
			break;
		case 7:
			for (i = -4 * u; i <= 4 * u; i++)
			{
				j = 4 * u - AbsI64(i);
				HLRect(dc, cx - j, cy + i, 2 * j + 1, 1, fg);
			}
			HLRect(dc, cx - u / 2, cy - 2 * u, u, 4 * u, ac);
			break;
		case 8:
			HLDisc(dc, cx, cy, 2 * u, fg);
			HLTriUp(dc, cx - 4 * u, cy - 2 * u, 2 * u, 4 * u, fg);
			HLTriUp(dc, cx + 4 * u, cy - 2 * u, 2 * u, 4 * u, fg);
			HLDisc(dc, cx - u, cy - u / 2, u / 2, ac);
			HLDisc(dc, cx + u, cy - u / 2, u / 2, ac);
			break;
		case 9:
			HLRect(dc, cx - 5 * u, cy, 10 * u, 3 * u, fg);
			HLRect(dc, cx - 3 * u, cy - 2 * u, 6 * u, 2 * u, fg);
			HLRect(dc, cx - 2 * u, cy - u, 4 * u, u, ac);
			HLDisc(dc, cx - 3 * u, cy + 3 * u, u + u / 2, ac);
			HLDisc(dc, cx + 3 * u, cy + 3 * u, u + u / 2, ac);
			break;
		case 10:
			HLDisc(dc, cx, cy, 4 * u, fg);
			HLDisc(dc, cx, cy, 3 * u, ac);
			HLDisc(dc, cx, cy, 2 * u, fg);
			HLDisc(dc, cx, cy, u, ac);
			break;
		case 11:
			HLRect(dc, cx - 3 * u, cy - 4 * u, u / 2 + 1, 8 * u, fg);
			HLRect(dc, cx - 3 * u, cy - 4 * u, 4 * u, 3 * u, fg);
			HLRect(dc, cx + 2 * u, cy - 4 * u, u / 2 + 1, 8 * u, ac);
			HLRect(dc, cx + 2 * u, cy - 4 * u, 4 * u, 3 * u, ac);
			break;
		case 12:
			HLDisc(dc, cx, cy + 2 * u, 4 * u, fg);
			HLRect(dc, cx, cy - 4 * u, u / 2 + 1, 6 * u, ac);
			HLTriUp(dc, cx + 2 * u, cy - 4 * u, 2 * u, 3 * u, ac);
			HLDisc(dc, cx - 2 * u, cy + 3 * u, u, ac);
			break;
		case 13:
			for (i = -1; i <= 1; i++)
			{
				HLTriUp(dc, cx + i * 3 * u, cy - 3 * u + AbsI64(i) * u, u, 2 * u, fg);
				HLDisc(dc, cx + i * 3 * u, cy - u + AbsI64(i) * u, u, fg);
			}
			HLRect(dc, cx - 5 * u, cy + 4 * u, 10 * u, u / 2 + 1, ac);
			break;
		case 14:
			HLRect(dc, cx - 5 * u, cy - 4 * u, 10 * u, 8 * u, fg);
			HLRect(dc, cx - 3 * u, cy - 2 * u, 6 * u, 4 * u, ac);
			HLRect(dc, cx - u, cy - u, 2 * u, 2 * u, fg);
			break;
		case 15:
			HLTriDown(dc, cx + u, cy - 4 * u, 3 * u, 4 * u, fg);
			HLTriUp(dc, cx - u, cy, 3 * u, 4 * u, fg);
			break;
		case 16:
			HLRect(dc, cx - 5 * u, cy - 4 * u, 10 * u, u / 2 + 1, fg);
			HLRect(dc, cx - 5 * u, cy + 4 * u, 10 * u, u / 2 + 1, fg);
			HLRect(dc, cx - 5 * u, cy - 4 * u, u / 2 + 1, 8 * u, fg);
			HLRect(dc, cx + 5 * u, cy - 4 * u, u / 2 + 1, 8 * u + 1, fg);
			HLRect(dc, cx - 2 * u, cy - 4 * u, u / 2 + 1, 5 * u, fg);
			HLRect(dc, cx + 2 * u, cy - u, u / 2 + 1, 5 * u, fg);
			HLRect(dc, cx - 2 * u, cy, 4 * u, u / 2 + 1, ac);
			break;
		case 17:
			HLDisc(dc, cx - u, cy + u, 3 * u, fg);
			HLRect(dc, cx - 4 * u, cy + u, 6 * u, 3 * u, fg);
			HLDisc(dc, cx - 2 * u, cy, u / 2, ac);
			HLDisc(dc, cx, cy, u / 2, ac);
			HLRect(dc, cx + 2 * u, cy - 4 * u, 3 * u, 2 * u, ac);
			HLRect(dc, cx + 3 * u, cy - 2 * u, u, 4 * u, ac);
			break;
		case 18:
			HLDisc(dc, cx - 2 * u, cy, 3 * u, fg);
			HLDisc(dc, cx + 2 * u, cy, 3 * u, ac);
			break;
		case 19:
			HLBig(dc, cx - 4 * u, cy - 2 * u, "123", u * 2 / 3, fg);
			break;
		default:
			HLIconB(dc, id, cx, cy, u, fg, ac);
			break;
	}
}
//SPLIT
// ================= FILE MANAGER =================
U8 fm_path[256] = "T:/";
U8 fm_names[200][40];
U8 fm_tn[200][40];
I64 fm_td[200], fm_ts[200], fm_tt[200];
I64 fm_dir[200], fm_size[200], fm_ord[200], fm_date[200];
I64 fm_n = 0, fm_scroll = 0, fm_sel = -1, fm_rows = 10;
U8 fm_clip[256];
I64 fm_clipdir = FALSE, fm_cut = FALSE, fm_confirm = FALSE, fm_mode = 0, fm_rowhover = -1, fm_bhover = -1, fm_dhover = -1, fm_shover = 0;
U8 fm_input[48];
I64 fm_ilen = 0;
I64 fm_bx[12], fm_by[12], fm_bw[12], fm_bh[12];
I64 fm_dx[26], fm_dy[26], fm_dw[26], fm_dh[26], fm_dl[26], fm_dn = 0;
I64 fm_ry0 = 0, fm_rh = 1, fm_rx0 = 0, fm_rw = 1;
U8 fm_tmp[300];
U8 fm_lab[16];

U0 HLFMFull(I64 i, U8 *out)
{
	if (StrLen(fm_path) <= 3)
		StrPrint(out, "%s%s", fm_path, fm_names[i]);
	else
		StrPrint(out, "%s/%s", fm_path, fm_names[i]);
}

U0 HLFMLoad()
{
	CDirEntry *list, *de;
	U8 mask[300];
	I64 i, j, t, c;
	fm_n = 0;
	fm_scroll = 0;
	fm_sel = -1;
	fm_confirm = FALSE;
	if (StrLen(fm_path) <= 3)
		StrPrint(mask, "%s*", fm_path);
	else
		StrPrint(mask, "%s/*", fm_path);
	list = FilesFind(mask, 0);
	de = list;
	while (de && fm_n < 200)
	{
		if (StrCompare(de->name, ".") && StrCompare(de->name, ".."))
		{
			StrCopy(fm_names[fm_n], de->name);
			if (de->attr & RS_ATTR_DIR)
				fm_dir[fm_n] = 1;
			else
				fm_dir[fm_n] = 0;
			fm_size[fm_n] = de->size;
			fm_date[fm_n] = de->datetime;
			fm_ord[fm_n] = fm_n;
			fm_n++;
		}
		de = de->next;
	}
	if (list)
		DirTreeDel(list);
	for (i = 0; i < fm_n; i++)
		for (j = 0; j < fm_n - 1 - i; j++)
		{
			c = 0;
			if (fm_dir[fm_ord[j]] < fm_dir[fm_ord[j + 1]])
				c = 1;
			else if (fm_dir[fm_ord[j]] == fm_dir[fm_ord[j + 1]] && StrICompare(fm_names[fm_ord[j]], fm_names[fm_ord[j + 1]]) > 0)
				c = 1;
			if (c)
			{
				t = fm_ord[j];
				fm_ord[j] = fm_ord[j + 1];
				fm_ord[j + 1] = t;
			}
		}
	for (i = 0; i < fm_n; i++)
	{
		StrCopy(fm_tn[i], fm_names[fm_ord[i]]);
		fm_td[i] = fm_dir[fm_ord[i]];
		fm_ts[i] = fm_size[fm_ord[i]];
		fm_tt[i] = fm_date[fm_ord[i]];
	}
	for (i = 0; i < fm_n; i++)
	{
		StrCopy(fm_names[i], fm_tn[i]);
		fm_dir[i] = fm_td[i];
		fm_size[i] = fm_ts[i];
		fm_date[i] = fm_tt[i];
		fm_ord[i] = i;
	}
	fm_dn = 0;
	for (c = 'A'; c <= 'Z'; c++)
		if (fm_dn < 26 && Letter2Drive(c, FALSE))
		{
			fm_dl[fm_dn] = c;
			fm_dn++;
		}
}

U0 HLFMUp()
{
	I64 i = StrLen(fm_path) - 1;
	if (i <= 2)
		return;
	while (i > 2 && fm_path[i] != '/')
		i--;
	if (i <= 2)
		fm_path[3] = 0;
	else
		fm_path[i] = 0;
	HLFMLoad;
}

//SPLIT
U0 HLFMOpen(I64 idx)
{
	U8 full[300];
	U8 *ext;
	if (idx < 0 || idx >= fm_n)
		return;
	HLFMFull(idx, full);
	if (fm_dir[idx])
	{
		StrCopy(fm_path, full);
		HLFMLoad;
		return;
	}
	ext = FileExtDot(fm_names[idx]);
	User("Ed(\"%s\");", full);
}

U0 HLFMRun(I64 idx)
{
	U8 full[300];
	U8 *ext;
	if (idx < 0 || idx >= fm_n || fm_dir[idx])
		return;
	ext = FileExtDot(fm_names[idx]);
	if (ext && !StrICompare(ext, ".ZC"))
	{
		HLFMFull(idx, full);
		User("ExeFile(\"%s\");", full);
	}
	else
		HLNote("RUN works on .ZC programs only.");
}

Bool HLFMMove(U8 *src, U8 *dst, I64 isdir)
{
	if (isdir)
	{
		if (CopyTree(src, dst))
		{
			DelTree(src);
			return TRUE;
		}
		return FALSE;
	}
	return Move(src, dst);
}

U0 HLFMPaste()
{
	U8 dst[300];
	U8 *base;
	if (!fm_clip[0])
	{
		HLNote("Nothing to paste.");
		return;
	}
	base = StrLastOcc(fm_clip, "/");
	if (base)
		base++;
	else
		base = fm_clip;
	if (StrLen(fm_path) <= 3)
		StrPrint(dst, "%s%s", fm_path, base);
	else
		StrPrint(dst, "%s/%s", fm_path, base);
	if (fm_path[0] == 'T')
	{
		HLNote("The disc is read-only.");
		return;
	}
	if (fm_cut)
	{
		if (HLFMMove(fm_clip, dst, fm_clipdir))
			HLNote("Moved.");
		else
			HLNote("Move failed.");
		fm_clip[0] = 0;
	}
	else
	{
		if (fm_clipdir)
			fm_n = CopyTree(fm_clip, dst);
		else
			fm_n = Copy(fm_clip, dst);
		if (fm_n)
			HLNote("Pasted.");
		else
			HLNote("Copy failed.");
	}
	HLFMLoad;
}

U0 HLFMDelete()
{
	U8 full[300];
	if (fm_sel < 0)
	{
		HLNote("Select a file first.");
		return;
	}
	if (fm_path[0] == 'T')
	{
		HLNote("The disc is read-only.");
		return;
	}
	if (!fm_confirm)
	{
		fm_confirm = TRUE;
		HLNote("Press DELETE again to confirm.");
		return;
	}
	HLFMFull(fm_sel, full);
	if (fm_dir[fm_sel])
		DelTree(full);
	else
		Del(full, FALSE, FALSE, FALSE);
	HLNote("Deleted.");
	HLFMLoad;
}

U0 HLFMEnter()
{
	U8 full[300];
	U8 old[300];
	if (fm_ilen == 0)
	{
		fm_mode = 0;
		return;
	}
	if (fm_path[0] == 'T')
	{
		HLNote("The disc is read-only.");
		fm_mode = 0;
		return;
	}
	if (StrLen(fm_path) <= 3)
		StrPrint(full, "%s%s", fm_path, fm_input);
	else
		StrPrint(full, "%s/%s", fm_path, fm_input);
	if (fm_mode == 1)
	{
		if (DirMake(full))
			HLNote("Folder created.");
		else
			HLNote("Could not create the folder.");
	}
	else if (fm_mode == 2 && fm_sel >= 0)
	{
		HLFMFull(fm_sel, old);
		if (HLFMMove(old, full, fm_dir[fm_sel]))
			HLNote("Renamed.");
		else
			HLNote("Rename failed.");
	}
	fm_mode = 0;
	HLFMLoad;
}

I64 HLFMAction(I64 act)
{
	if (act == 0)
		HLFMUp;
	else if (act == 1)
	{
		if (fm_path[0] == 'T')
			HLNote("The disc is read-only.");
		else
		{
			fm_mode = 1;
			fm_input[0] = 0;
			fm_ilen = 0;
		}
	}
	else if (act == 2 || act == 3)
	{
		if (fm_sel < 0)
			HLNote("Select a file first.");
		else
		{
			HLFMFull(fm_sel, fm_clip);
			fm_clipdir = fm_dir[fm_sel];
			if (act == 3)
				fm_cut = TRUE;
			else
				fm_cut = FALSE;
			HLNote("Copied to the clipboard.");
		}
	}
	else if (act == 4)
		HLFMPaste;
	else if (act == 5)
	{
		if (fm_sel < 0)
			HLNote("Select a file first.");
		else if (fm_path[0] == 'T')
			HLNote("The disc is read-only.");
		else
		{
			fm_mode = 2;
			StrCopy(fm_input, fm_names[fm_sel]);
			fm_ilen = StrLen(fm_input);
		}
	}
	else if (act == 6)
		HLFMDelete;
	else if (act == 7)
		HLFMOpen(fm_sel);
	else if (act == 8)
		HLFMRun(fm_sel);
	else if (act == 9)
		return 1;
	return 0;
}

U0 HLFMKey(I64 k)
{
	if (fm_mode)
	{
		if (k == CH_ESC)
			fm_mode = 0;
		else if (k == '\n')
			HLFMEnter;
		else if (k == CH_BACKSPACE)
		{
			if (fm_ilen > 0)
			{
				fm_ilen--;
				fm_input[fm_ilen] = 0;
			}
		}
		else if (k >= 32 && k < 127 && fm_ilen < 36)
		{
			fm_input[fm_ilen] = k;
			fm_ilen++;
			fm_input[fm_ilen] = 0;
		}
		return;
	}
	if (k == CH_BACKSPACE || k == 'u')
		HLFMUp;
	else if (k == '\n' || k == 'o')
		HLFMOpen(fm_sel);
	else if (k == 'n')
		HLFMAction(1);
	else if (k == 'c')
		HLFMAction(2);
	else if (k == 'x')
		HLFMAction(3);
	else if (k == 'v')
		HLFMAction(4);
	else if (k == 'r')
		HLFMAction(5);
	else if (k == 'd')
		HLFMAction(6);
	else if (k == 'e')
		HLFMAction(8);
	else if (k == 'j' && fm_sel < fm_n - 1)
	{
		fm_sel++;
		fm_confirm = FALSE;
		if (fm_sel >= fm_scroll + fm_rows)
			fm_scroll++;
	}
	else if (k == 'k' && fm_sel > 0)
	{
		fm_sel--;
		fm_confirm = FALSE;
		if (fm_sel < fm_scroll)
			fm_scroll--;
	}
	else if (k >= '1' && k <= '9' && k - '1' < fm_dn)
	{
		StrPrint(fm_path, "%c:/", fm_dl[k - '1']);
		HLFMLoad;
	}
}

I64 HLFMClick()
{
	I64 i;
	if (fm_mode)
		return 0;
	if (fm_dhover >= 0)
	{
		StrPrint(fm_path, "%c:/", fm_dl[fm_dhover]);
		HLFMLoad;
		return 0;
	}
	if (fm_shover == 1 && fm_scroll > 0)
		fm_scroll -= fm_rows - 1;
	else if (fm_shover == 2 && fm_scroll + fm_rows < fm_n)
		fm_scroll += fm_rows - 1;
	if (fm_scroll < 0)
		fm_scroll = 0;
	if (fm_bhover >= 0)
	{
		if (HLFMAction(fm_bhover))
			return 1;
	}
	if (fm_rowhover >= 0)
	{
		i = fm_rowhover;
		if (i == fm_sel)
			HLFMOpen(i);
		else
		{
			fm_sel = i;
			fm_confirm = FALSE;
		}
	}
	return 0;
}

//SPLIT
U0 HLFMDraw(CDC *dc, I64 w, I64 h, I64 sc, I64 mx, I64 my, I64 hdr)
{
	I64 i, j, x, y, bw, bh, nb, y0, ly, idx, rows, shown, sw, ns, nsz;
	CDateStruct ds;
	U8 buf[64];
	U8 st[160];
	y0 = hdr + 8 * sc;
	bh = 12 * sc;
	// drive buttons + path
	fm_dhover = -1;
	x = 4 * sc;
	for (i = 0; i < fm_dn; i++)
	{
		fm_dx[i] = x;
		fm_dy[i] = y0;
		fm_dw[i] = 12 * sc;
		fm_dh[i] = bh;
		if (mx >= x && mx < x + 12 * sc && my >= y0 && my < y0 + bh)
			fm_dhover = i;
		HLRect(dc, x + sc, y0 + sc, 12 * sc, bh, LTGRAY);
		if (fm_path[0] == fm_dl[i])
			HLRect(dc, x, y0, 12 * sc, bh, BLUE);
		else
			HLRect(dc, x, y0, 12 * sc, bh, LTBLUE);
		if (i == fm_dhover)
			HLRect(dc, x, y0, 12 * sc, bh, BLUE);
		StrPrint(buf, "%c:", fm_dl[i]);
		HLBig(dc, x + (12 * sc - HLWidth(buf, sc)) / 2, y0 + (bh - 8 * sc) / 2, buf, sc, WHITE);
		x += 14 * sc;
	}
	HLRect(dc, x + 2 * sc, y0, w - x - 6 * sc, bh, LTGRAY);
	HLBig(dc, x + 4 * sc, y0 + (bh - 8 * sc) / 2, fm_path, sc, BLACK);
	// toolbar
	nb = 10;
	y = y0 + bh + 3 * sc;
	bw = (w - 8 * sc - (nb - 1) * 2 * sc) / nb;
	fm_bhover = -1;
	for (i = 0; i < nb; i++)
	{
		fm_bx[i] = 4 * sc + i * (bw + 2 * sc);
		fm_by[i] = y;
		fm_bw[i] = bw;
		fm_bh[i] = bh;
		if (mx >= fm_bx[i] && mx < fm_bx[i] + bw && my >= y && my < y + bh)
			fm_bhover = i;
		if (i == 0) StrCopy(fm_lab, "UP");
		else if (i == 1) StrCopy(fm_lab, "NEW");
		else if (i == 2) StrCopy(fm_lab, "COPY");
		else if (i == 3) StrCopy(fm_lab, "CUT");
		else if (i == 4) StrCopy(fm_lab, "PASTE");
		else if (i == 5) StrCopy(fm_lab, "RENAME");
		else if (i == 6) StrCopy(fm_lab, "DELETE");
		else if (i == 7) StrCopy(fm_lab, "OPEN");
		else if (i == 8) StrCopy(fm_lab, "RUN");
		else StrCopy(fm_lab, "CLOSE");
		HLRect(dc, fm_bx[i] + sc, y + sc, bw, bh, LTGRAY);
		if (i == 6)
			HLRect(dc, fm_bx[i], y, bw, bh, RED);
		else if (i == 9)
			HLRect(dc, fm_bx[i], y, bw, bh, DKGRAY);
		else if (i == 4 || i == 1)
			HLRect(dc, fm_bx[i], y, bw, bh, GREEN);
		else
			HLRect(dc, fm_bx[i], y, bw, bh, BLUE);
		if (i == fm_bhover)
			HLRect(dc, fm_bx[i], y, bw, bh, BLACK);
		ns = bw / (StrLen(fm_lab) * 8);
		if (ns > sc) ns = sc;
		if (ns < 1) ns = 1;
		HLBig(dc, fm_bx[i] + (bw - HLWidth(fm_lab, ns)) / 2, y + (bh - 8 * ns) / 2, fm_lab, ns, WHITE);
	}
	// list
	ly = y + bh + 3 * sc;
	fm_rh = 10 * sc;
	fm_rx0 = 4 * sc;
	fm_rw = w - 8 * sc - 14 * sc;
	rows = (h - ly - 18 * sc) / fm_rh;
	if (rows < 3) rows = 3;
	fm_rows = rows;
	fm_ry0 = ly;
	HLRect(dc, fm_rx0, ly, fm_rw, rows * fm_rh, LTGRAY);
	fm_rowhover = -1;
	for (i = 0; i < rows; i++)
	{
		idx = fm_scroll + i;
		if (idx >= fm_n)
			break;
		j = fm_ord[idx];
		y = ly + i * fm_rh;
		if (idx == fm_sel)
			HLRect(dc, fm_rx0, y, fm_rw, fm_rh, LTBLUE);
		else
		{
			if (i % 2)
				HLRect(dc, fm_rx0, y, fm_rw, fm_rh, WHITE);
			else
				HLRect(dc, fm_rx0, y, fm_rw, fm_rh, LTGRAY);
		}
		if (mx >= fm_rx0 && mx < fm_rx0 + fm_rw && my >= y && my < y + fm_rh)
		{
			fm_rowhover = idx;
			HLRect(dc, fm_rx0, y, 3 * sc, fm_rh, YELLOW);
		}
		if (fm_dir[j])
			HLIcon(dc, 32, fm_rx0 + 8 * sc, y + fm_rh / 2, sc / 2 + 1, BROWN, WHITE);
		else
			HLIcon(dc, 33, fm_rx0 + 8 * sc, y + fm_rh / 2, sc / 2 + 1, BLUE, WHITE);
		ns = sc / 2 + 1;
		HLBig(dc, fm_rx0 + 16 * sc, y + (fm_rh - 8 * ns) / 2, fm_names[j], ns, BLACK);
		if (!fm_dir[j])
		{
			if (fm_size[j] < 1024)
				StrPrint(buf, "%d B", fm_size[j]);
			else if (fm_size[j] < 1048576)
				StrPrint(buf, "%d KB", fm_size[j] / 1024);
			else
				StrPrint(buf, "%d MB", fm_size[j] / 1048576);
			HLBig(dc, fm_rx0 + fm_rw * 60 / 100, y + (fm_rh - 8 * (sc / 2)) / 2, buf, sc / 2, DKGRAY);
		}
		else
			HLBig(dc, fm_rx0 + fm_rw * 60 / 100, y + (fm_rh - 8 * (sc / 2)) / 2, "FOLDER", sc / 2, DKGRAY);
		Date2Struct(&ds, fm_date[j]);
		StrPrint(buf, "%04d-%02d-%02d %02d:%02d", ds.year, ds.mon, ds.day_of_mon, ds.hour, ds.min);
		HLBig(dc, fm_rx0 + fm_rw * 76 / 100, y + (fm_rh - 8 * (sc / 2)) / 2, buf, sc / 2, DKGRAY);
	}
	if (fm_n == 0)
		HLBig(dc, fm_rx0 + 4 * sc, ly + 4 * sc, "THIS FOLDER IS EMPTY", sc, DKGRAY);
	// scroll buttons
	sw = 12 * sc;
	fm_shover = 0;
	x = w - 4 * sc - sw;
	if (mx >= x && mx < x + sw && my >= ly && my < ly + 2 * sw)
		fm_shover = 1;
	if (mx >= x && mx < x + sw && my >= ly + rows * fm_rh - 2 * sw && my < ly + rows * fm_rh)
		fm_shover = 2;
	HLRect(dc, x, ly, sw, 2 * sw, LTBLUE);
	HLTriUp(dc, x + sw / 2, ly + sw / 2, sw / 3, sw, WHITE);
	HLRect(dc, x, ly + rows * fm_rh - 2 * sw, sw, 2 * sw, LTBLUE);
	HLTriDown(dc, x + sw / 2, ly + rows * fm_rh - 2 * sw + sw / 2, sw / 3, sw, WHITE);
	// status line
	StrPrint(st, "%d ITEMS", fm_n);
	if (fm_sel >= 0)
		StrPrint(st, "%d ITEMS   SELECTED: %s   (CLICK AGAIN TO OPEN)", fm_n, fm_names[fm_ord[fm_sel]]);
	HLBig(dc, 4 * sc, ly + rows * fm_rh + 3 * sc, st, sc / 2 + 1, DKGRAY);
	// text input box
	if (fm_mode)
	{
		x = w / 2 - 80 * sc;
		y = h / 2 - 16 * sc;
		HLRect(dc, x + sc, y + sc, 160 * sc, 32 * sc, DKGRAY);
		HLRect(dc, x, y, 160 * sc, 32 * sc, WHITE);
		HLRect(dc, x, y, 160 * sc, 3 * sc, BLUE);
		if (fm_mode == 1)
			HLBig(dc, x + 4 * sc, y + 5 * sc, "NEW FOLDER NAME:", sc, BLACK);
		else
			HLBig(dc, x + 4 * sc, y + 5 * sc, "NEW NAME:", sc, BLACK);
		HLRect(dc, x + 4 * sc, y + 14 * sc, 152 * sc, 10 * sc, LTGRAY);
		HLBig(dc, x + 6 * sc, y + 15 * sc, fm_input, sc, BLACK);
		HLBig(dc, x + 4 * sc, y + 26 * sc, "ENTER = OK    ESC = CANCEL", sc / 2 + 1, DKGRAY);
	}
}

//SPLIT
// ================= PAD, CHROME, TILES, DRAW =================
I64 HLScale(I64 w)
{
	I64 sc = w / 400;
	if (sc < 2)
		sc = 2;
	return sc;
}

U0 HLPadReset(HLPad *p)
{
	p->len = 0;
	p->entry[0] = 0;
	p->wrong = 0;
	p->hover = -1;
}

U0 HLPadAdd(HLPad *p, I64 d)
{
	if (p->len < 4)
	{
		p->entry[p->len] = '0' + d;
		p->len++;
		p->entry[p->len] = 0;
	}
}

U0 HLPadBack(HLPad *p)
{
	if (p->len > 0)
	{
		p->len--;
		p->entry[p->len] = 0;
	}
}

U0 HLDrawPad(CDC *dc, I64 w, I64 h, I64 sc, I64 mx, I64 my, HLPad *p, U8 *title, I64 top)
{
	I64 i, x, y, bs, gap, avail, x0, y0;
	U8 lab[8];
	HLBig(dc, (w - HLWidth(title, sc)) / 2, top + 4 * sc, title, sc, BLACK);
	for (i = 0; i < 4; i++)
	{
		x = w / 2 - 24 * sc + i * 12 * sc;
		if (i < p->len)
			HLDisc(dc, x + 3 * sc, top + 18 * sc, 3 * sc, BLUE);
		else
			HLDisc(dc, x + 3 * sc, top + 18 * sc, 3 * sc, LTGRAY);
	}
	if (p->wrong)
		HLBig(dc, (w - HLWidth("WRONG PIN", sc)) / 2, top + 24 * sc, "WRONG PIN", sc, RED);
	gap = 3 * sc;
	bs = 18 * sc;
	avail = h - top - 34 * sc;
	if (bs * 4 + gap * 3 > avail)
		bs = (avail - gap * 3) / 4;
	if (bs < 8)
		bs = 8;
	p->ks = bs;
	x0 = (w - 3 * bs - 2 * gap) / 2;
	y0 = top + 32 * sc;
	p->hover = -1;
	for (i = 0; i < 12; i++)
	{
		p->kx[i] = x0 + (i % 3) * (bs + gap);
		p->ky[i] = y0 + (i / 3) * (bs + gap);
		x = p->kx[i];
		y = p->ky[i];
		if (mx >= x && mx < x + bs && my >= y && my < y + bs)
			p->hover = i;
		HLRect(dc, x + sc, y + sc, bs, bs, LTGRAY);
		if (i == p->hover)
			HLRect(dc, x, y, bs, bs, BLUE);
		else
			HLRect(dc, x, y, bs, bs, LTBLUE);
		if (i < 9)
			StrPrint(lab, "%d", i + 1);
		else if (i == 9)
			StrCopy(lab, "<");
		else if (i == 10)
			StrCopy(lab, "0");
		else
			StrCopy(lab, "OK");
		HLBig(dc, x + (bs - HLWidth(lab, sc)) / 2, y + (bs - 8 * sc) / 2, lab, sc, WHITE);
	}
}

U0 HLDrawTiles(CDC *dc, I64 k, I64 w, I64 h, I64 sc, I64 mx, I64 my, I64 top)
{
	I64 i, row, col, x, y, tw, th, gx, gy, ns, ncols, nrows, u, body, maxth;
	gx = 4 * sc;
	gy = top + 6 * sc;
	if (k == 0)
		ncols = 4;
	else
	{
		ncols = (w - 8 * sc) / (70 * sc);
		if (ncols < 2) ncols = 2;
		if (ncols > 6) ncols = 6;
	}
	nrows = (hl_cnt[k] + ncols - 1) / ncols;
	tw = (w - gx * 2 - (ncols - 1) * 3 * sc) / ncols;
	th = (h - gy - 8 * sc - (nrows - 1) * 3 * sc) / nrows;
	if (k == 0)
		maxth = 90 * sc;
	else
		maxth = 50 * sc;
	if (th > maxth) th = maxth;
	if (th < 24 * sc) th = 24 * sc;
	hl_hov[k] = -1;
	for (i = 0; i < hl_cnt[k]; i++)
	{
		row = i / ncols;
		col = i % ncols;
		x = gx + col * (tw + 3 * sc);
		y = gy + row * (th + 3 * sc);
		if (mx >= x && mx < x + tw && my >= y && my < y + th)
			hl_hov[k] = i;
		body = th - 12 * sc;
		HLRect(dc, x + sc, y + sc, tw, th, LTGRAY);
		HLRect(dc, x, y, tw, th, hl_it[k][i].light);
		HLRect(dc, x, y + body, tw, th - body, hl_it[k][i].dark);
		u = body * 2 / 21;
		if (u < 2) u = 2;
		HLIcon(dc, hl_it[k][i].icon, x + tw / 2, y + body / 2, u, WHITE, hl_it[k][i].dark);
		ns = tw / (StrLen(hl_it[k][i].label) * 8);
		if (ns > sc) ns = sc;
		if (ns < 1) ns = 1;
		HLBig(dc, x + (tw - HLWidth(hl_it[k][i].label, ns)) / 2, y + body + (th - body - 8 * ns) / 2, hl_it[k][i].label, ns, WHITE);
		if (i == hl_hov[k])
		{
			HLRect(dc, x - 3, y - 3, tw + 6, 4, BLACK);
			HLRect(dc, x - 3, y + th - 1, tw + 6, 4, BLACK);
			HLRect(dc, x - 3, y - 3, 4, th + 6, BLACK);
			HLRect(dc, x + tw - 1, y - 3, 4, th + 6, BLACK);
		}
	}
}

//SPLIT
U0 HLDrawHeader(CDC *dc, I64 w, I64 sc, I64 hdr)
{
	I64 y, band;
	CDateStruct ds;
	for (y = 0; y < hdr; y++)
	{
		band = y * 8 / hdr;
		if (band < 2)
			dc->color = BLUE;
		else if (band < 3)
		{
			if (y % 2) dc->color = BLUE; else dc->color = LTBLUE;
		}
		else if (band < 5)
			dc->color = LTBLUE;
		else if (band < 6)
		{
			if (y % 2) dc->color = LTBLUE; else dc->color = LTPURPLE;
		}
		else
			dc->color = LTPURPLE;
		GrRect(dc, 0, y, w, 1);
	}
	HLRect(dc, 0, hdr, w, 4, YELLOW);
	HLBig(dc, 3 * sc + sc / 2, 3 * sc + sc / 2, "HOLY TEMPLEOS", sc * 2, BLACK);
	HLBig(dc, 3 * sc, 3 * sc, "HOLY TEMPLEOS", sc * 2, WHITE);
	HLBig(dc, 3 * sc, 3 * sc + 16 * sc + 6, "BY MINESWORD TEAM - BASED ON TEMPLEOS", sc / 2 + 1, WHITE);
	Date2Struct(&ds, Now);
	StrPrint(hl_clock, "%02d:%02d", ds.hour, ds.min);
	StrPrint(hl_date, "%04d-%02d-%02d", ds.year, ds.mon, ds.day_of_mon);
	HLBig(dc, w - HLWidth(hl_clock, sc * 2) - 3 * sc + sc / 2, 3 * sc + sc / 2, hl_clock, sc * 2, BLACK);
	HLBig(dc, w - HLWidth(hl_clock, sc * 2) - 3 * sc, 3 * sc, hl_clock, sc * 2, WHITE);
}

U0 HLDrawPanel(CDC *dc, I64 w, I64 h, I64 sc, I64 mx, I64 my)
{
	I64 i, ph, py, bx, bw, bh, by, nx;
	ph = 36 * sc;
	py = h - ph;
	HLRect(dc, 0, py - 4, w, 4, YELLOW);
	HLRect(dc, 0, py, w, ph, LTGRAY);
	HLBig(dc, 4 * sc, py + 3 * sc, hl_clock, sc * 2, BLACK);
	HLBig(dc, 4 * sc, py + 3 * sc + 18 * sc, hl_date, sc, DKGRAY);
	bw = 18 * sc;
	bh = 22 * sc;
	by = py + 6 * sc;
	bx = 70 * sc;
	hl_pbn = 3;
	hl_pbhover = -1;
	for (i = 0; i < 3; i++)
	{
		hl_pbx[i] = bx + i * (bw + 3 * sc);
		hl_pby[i] = by;
		hl_pbw[i] = bw;
		hl_pbh[i] = bh;
		if (mx >= hl_pbx[i] && mx < hl_pbx[i] + bw && my >= by && my < by + bh)
			hl_pbhover = i;
		HLRect(dc, hl_pbx[i], by, bw, bh, WHITE);
		if (i == hl_pbhover)
			HLRect(dc, hl_pbx[i], by, bw, bh, LTBLUE);
		if (i == 0)
		{
			StrCopy(hl_plab, "THEME");
			HLIcon(dc, 22, hl_pbx[i] + bw / 2, by + bh / 2 - sc, sc, BROWN, WHITE);
		}
		else if (i == 1)
		{
			StrCopy(hl_plab, "LOCK");
			HLIcon(dc, 25, hl_pbx[i] + bw / 2, by + bh / 2 - sc, sc, GREEN, WHITE);
		}
		else
		{
			StrCopy(hl_plab, "REBOOT");
			HLIcon(dc, 30, hl_pbx[i] + bw / 2, by + bh / 2 - sc, sc, RED, WHITE);
		}
		HLBig(dc, hl_pbx[i] + (bw - HLWidth(hl_plab, sc / 2 + 1)) / 2, by + bh + 2 * sc, hl_plab, sc / 2 + 1, DKGRAY);
	}
	nx = bx + 3 * (bw + 3 * sc) + 12 * sc;
	HLIcon(dc, 31, nx + 3 * sc, py + 8 * sc, sc, BROWN, LTGRAY);
	HLBig(dc, nx + 10 * sc, py + 3 * sc, "NOTIFICATIONS", sc / 2 + 1, BLACK);
	for (i = 0; i < hl_note_n; i++)
		HLBig(dc, nx + 10 * sc, py + 9 * sc + i * 6 * sc, hl_notes[i], sc / 2 + 1, DKGRAY);
	if (hl_note_n == 0)
		HLBig(dc, nx + 10 * sc, py + 9 * sc, "NO NEW NOTIFICATIONS", sc / 2 + 1, DKGRAY);
}

//SPLIT
// ================= CONTENT, WINDOWS, DESKTOP DRAW =================
U0 HLContentGames(CDC *dc, I64 w, I64 h, I64 sc, I64 mx, I64 my)
{
	HLDrawTiles(dc, 1, w, h, sc, mx, my, 0);
}

U0 HLContentFiles(CDC *dc, I64 w, I64 h, I64 sc, I64 mx, I64 my)
{
	HLFMDraw(dc, w, h, sc, mx, my, 0);
}

U0 HLContentSettings(CDC *dc, I64 w, I64 h, I64 sc, I64 mx, I64 my)
{
	if (hl_setmode)
	{
		HLDrawPad(dc, w, h, sc, mx, my, &hl_setpad, "ENTER A NEW 4-DIGIT PIN", 0);
		HLBig(dc, 4 * sc, h - 7 * sc, "ESC = CANCEL", sc / 2 + 1, DKGRAY);
	}
	else
		HLDrawTiles(dc, 2, w, h, sc, mx, my, 0);
}

I64 hl_ibx[2], hl_iby[2], hl_ibw[2], hl_ibh[2], hl_ihover = -1;

U0 HLContentInstall(CDC *dc, I64 w, I64 h, I64 sc, I64 mx, I64 my)
{
	I64 i, y, bw, bh;
	HLBig(dc, (w - HLWidth("INSTALL HOLY TEMPLEOS", sc * 2)) / 2, 6 * sc, "INSTALL HOLY TEMPLEOS", sc * 2, BLUE);
	y = 28 * sc;
	HLRect(dc, 6 * sc, y, w - 12 * sc, 62 * sc, LTGRAY);
	HLIcon(dc, 0, 20 * sc, y + 31 * sc, sc * 2, GREEN, LTGRAY);
	HLBig(dc, 38 * sc, y + 5 * sc, "1.  THE INSTALLER ASKS WHICH DISK TO USE.", sc, BLACK);
	HLBig(dc, 38 * sc, y + 15 * sc, "2.  IN A VIRTUAL MACHINE THE FIRST DISK IS ERASED.", sc, RED);
	HLBig(dc, 38 * sc, y + 25 * sc, "3.  ON A REAL PC PREPARE A PARTITION FIRST.", sc, BLACK);
	HLBig(dc, 38 * sc, y + 35 * sc, "4.  AT THE END REMOVE THE DISC AND REBOOT.", sc, BLACK);
	HLBig(dc, 38 * sc, y + 48 * sc, "NEEDS THE BSD2-UEFI ISO (IT HAS THE BOOT LOADER).", sc / 2 + 1, DKGRAY);
	bw = 90 * sc;
	bh = 20 * sc;
	y = y + 70 * sc;
	hl_ihover = -1;
	for (i = 0; i < 2; i++)
	{
		hl_ibx[i] = w / 2 - bw - 4 * sc + i * (bw + 8 * sc);
		hl_iby[i] = y;
		hl_ibw[i] = bw;
		hl_ibh[i] = bh;
		if (mx >= hl_ibx[i] && mx < hl_ibx[i] + bw && my >= y && my < y + bh)
			hl_ihover = i;
		HLRect(dc, hl_ibx[i] + sc, y + sc, bw, bh, LTGRAY);
		if (i == 0)
			HLRect(dc, hl_ibx[i], y, bw, bh, GREEN);
		else
			HLRect(dc, hl_ibx[i], y, bw, bh, RED);
		if (i == hl_ihover)
			HLRect(dc, hl_ibx[i], y, bw, bh, BLACK);
		if (i == 0)
			HLBig(dc, hl_ibx[i] + (bw - HLWidth("START", sc)) / 2, y + (bh - 8 * sc) / 2, "START", sc, WHITE);
		else
			HLBig(dc, hl_ibx[i] + (bw - HLWidth("CANCEL", sc)) / 2, y + (bh - 8 * sc) / 2, "CANCEL", sc, WHITE);
	}
}

//SPLIT
U0 HLWinTitle(I64 id, U8 *out)
{
	if (id == 1)
		StrCopy(out, "GAMES");
	else if (id == 2)
		StrCopy(out, "FILES");
	else if (id == 3)
		StrCopy(out, "SETTINGS");
	else
		StrCopy(out, "INSTALL");
}

// hit codes: 0 none, 1 minimize, 2 maximize, 3 close, 4 title (move), 5 body, 6 edge (resize)
I64 HLWinHit(I64 id, I64 sc, I64 px, I64 py)
{
	I64 x = hw_x[id], y = hw_y[id], w = hw_w[id], h = hw_h[id], th = 12 * sc, bw = 10 * sc, e = 3 * sc, bx, f = 0;
	if (px < x - e || px >= x + w + e || py < y - e || py >= y + h + e)
		return 0;
	if (!hw_max[id])
	{
		if (px < x + e) f |= 1;
		if (px >= x + w - e) f |= 2;
		if (py < y + e) f |= 4;
		if (py >= y + h - e) f |= 8;
	}
	hw_edge = f;
	if (f)
		return 6;
	if (py < y + th)
	{
		bx = x + w - (bw + 2 * sc);
		if (px >= bx)
			return 3;
		if (px >= bx - (bw + 2 * sc))
			return 2;
		if (px >= bx - 2 * (bw + 2 * sc))
			return 1;
		return 4;
	}
	return 5;
}

I64 hw_hit = 0;

// top-most visible window under the pointer (0 = none); sets hw_hit
I64 HLTopUnder(I64 sc, I64 px, I64 py)
{
	I64 i, id, r;
	hw_hit = 0;
	for (i = hw_zn - 1; i >= 0; i--)
	{
		id = hw_z[i];
		if (hw_open[id] && !hw_min[id])
		{
			r = HLWinHit(id, sc, px, py);
			if (r)
			{
				hw_hit = r;
				return id;
			}
		}
	}
	return 0;
}

U0 HLWinTop(I64 id)
{
	I64 i, j = 0;
	for (i = 0; i < hw_zn; i++)
		if (hw_z[i] != id)
		{
			hw_z[j] = hw_z[i];
			j++;
		}
	hw_z[j] = id;
	hw_zn = j + 1;
}

U0 HLWinRemove(I64 id)
{
	I64 i, j = 0;
	for (i = 0; i < hw_zn; i++)
		if (hw_z[i] != id)
		{
			hw_z[j] = hw_z[i];
			j++;
		}
	hw_zn = j;
}

I64 hl_sw = 1920, hl_sh = 1080, hl_ssc = 4;

U0 HLWinOpen(I64 id)
{
	I64 w, h;
	if (hw_open[id])
	{
		hw_min[id] = FALSE;
		HLWinTop(id);
		return;
	}
	if (id == 1)
	{
		w = hl_sw * 70 / 100;
		h = hl_sh * 62 / 100;
	}
	else if (id == 2)
	{
		w = hl_sw * 78 / 100;
		h = hl_sh * 70 / 100;
	}
	else if (id == 3)
	{
		w = hl_sw * 52 / 100;
		h = hl_sh * 58 / 100;
	}
	else
	{
		w = hl_sw * 56 / 100;
		h = hl_sh * 52 / 100;
	}
	hw_w[id] = w;
	hw_h[id] = h;
	hw_x[id] = (hl_sw - w) / 2 + (id - 2) * 8 * hl_ssc;
	hw_y[id] = (hl_sh - h) / 2 + (id - 2) * 6 * hl_ssc - 6 * hl_ssc;
	if (hw_y[id] < 2 * hl_ssc)
		hw_y[id] = 2 * hl_ssc;
	hw_open[id] = TRUE;
	hw_min[id] = FALSE;
	hw_max[id] = FALSE;
	HLWinTop(id);
	if (id == 2)
		HLFMLoad;
}

U0 HLWinClose(I64 id)
{
	hw_open[id] = FALSE;
	hw_min[id] = FALSE;
	hw_max[id] = FALSE;
	HLWinRemove(id);
	if (id == 3)
		hl_setmode = 0;
	if (id == 2)
		fm_mode = 0;
}

U0 HLWinMaxToggle(I64 id)
{
	if (!hw_max[id])
	{
		hw_sv[id][0] = hw_x[id];
		hw_sv[id][1] = hw_y[id];
		hw_sv[id][2] = hw_w[id];
		hw_sv[id][3] = hw_h[id];
		hw_x[id] = 0;
		hw_y[id] = 0;
		hw_w[id] = hl_sw;
		hw_h[id] = hl_sh - 12 * hl_ssc;
		hw_max[id] = TRUE;
	}
	else
	{
		hw_x[id] = hw_sv[id][0];
		hw_y[id] = hw_sv[id][1];
		hw_w[id] = hw_sv[id][2];
		hw_h[id] = hw_sv[id][3];
		hw_max[id] = FALSE;
	}
}

//SPLIT
U0 HLDrawWindow(CDC *dc, I64 id, I64 sc, I64 mx, I64 my, I64 active, I64 under)
{
	I64 x = hw_x[id], y = hw_y[id], w = hw_w[id], h = hw_h[id], th = 12 * sc, bw = 10 * sc, bx, bh = th - 2 * sc, hit = 0, bc;
	U8 title[16];
	if (under)
		hit = HLWinHit(id, sc, mx, my);
	if (!hw_max[id])
		HLRect(dc, x + 2 * sc, y + 2 * sc, w, h, DKGRAY);
	if (active)
		bc = BLUE;
	else
		bc = DKGRAY;
	HLRect(dc, x, y, w, h, bc);
	HLRect(dc, x + 2, y + th, w - 4, h - th - 2, WHITE);
	HLWinTitle(id, title);
	HLBig(dc, x + 3 * sc, y + (th - 8 * sc) / 2, title, sc, WHITE);
	bx = x + w - (bw + 2 * sc);
	// close
	if (hit == 3) HLRect(dc, bx, y + sc, bw, bh, LTRED); else HLRect(dc, bx, y + sc, bw, bh, RED);
	HLBig(dc, bx + (bw - 8 * (sc / 2 + 1)) / 2, y + sc + (bh - 8 * (sc / 2 + 1)) / 2, "X", sc / 2 + 1, WHITE);
	// maximize
	bx -= bw + 2 * sc;
	if (hit == 2) HLRect(dc, bx, y + sc, bw, bh, WHITE); else HLRect(dc, bx, y + sc, bw, bh, LTBLUE);
	HLRect(dc, bx + 2 * sc, y + sc + 2 * sc, bw - 4 * sc, bh - 4 * sc, BLUE);
	HLRect(dc, bx + 3 * sc, y + sc + 3 * sc, bw - 6 * sc, bh - 6 * sc, WHITE);
	// minimize
	bx -= bw + 2 * sc;
	if (hit == 1) HLRect(dc, bx, y + sc, bw, bh, WHITE); else HLRect(dc, bx, y + sc, bw, bh, LTBLUE);
	HLRect(dc, bx + 2 * sc, y + sc + bh - 4 * sc, bw - 4 * sc, sc + 1, BLUE);
	// content
	hl_ox = x + 2;
	hl_oy = y + th;
	if (hit == 5)
	{
		mx -= x + 2;
		my -= y + th;
	}
	else
	{
		mx = -9999;
		my = -9999;
	}
	if (id == 1)
		HLContentGames(dc, w - 4, h - th - 2, HLScale(w), mx, my);
	else if (id == 2)
		HLContentFiles(dc, w - 4, h - th - 2, HLScale(w), mx, my);
	else if (id == 3)
		HLContentSettings(dc, w - 4, h - th - 2, HLScale(w), mx, my);
	else
		HLContentInstall(dc, w - 4, h - th - 2, HLScale(w), mx, my);
	hl_ox = 0;
	hl_oy = 0;
}

// taskbar: returns window id of the button under the pointer (0 = none)
I64 HLTaskHit(I64 sc, I64 w, I64 h, I64 px, I64 py)
{
	I64 i, n = 0, bw = 40 * sc, x;
	if (py < h - 12 * sc || py >= h)
		return 0;
	for (i = 1; i <= 4; i++)
		if (hw_open[i])
		{
			x = 2 * sc + n * (bw + 2 * sc);
			if (px >= x && px < x + bw)
				return i;
			n++;
		}
	return 0;
}

U0 HLDrawTaskbar(CDC *dc, I64 w, I64 h, I64 sc, I64 mx, I64 my)
{
	I64 i, n = 0, bw = 40 * sc, x, hov;
	U8 title[16];
	hov = HLTaskHit(sc, w, h, mx, my);
	HLRect(dc, 0, h - 12 * sc, w, 12 * sc, LTGRAY);
	HLRect(dc, 0, h - 12 * sc, w, 2, DKGRAY);
	for (i = 1; i <= 4; i++)
		if (hw_open[i])
		{
			x = 2 * sc + n * (bw + 2 * sc);
			if (hw_min[i])
				HLRect(dc, x, h - 11 * sc, bw, 10 * sc, LTBLUE);
			else if (hw_z[hw_zn - 1] == i)
				HLRect(dc, x, h - 11 * sc, bw, 10 * sc, BLUE);
			else
				HLRect(dc, x, h - 11 * sc, bw, 10 * sc, DKGRAY);
			if (hov == i)
				HLRect(dc, x, h - 11 * sc, bw, 2, BLACK);
			HLWinTitle(i, title);
			HLBig(dc, x + (bw - HLWidth(title, sc / 2 + 1)) / 2, h - 11 * sc + (10 * sc - 8 * (sc / 2 + 1)) / 2, title, sc / 2 + 1, WHITE);
			n++;
		}
}

U0 HLDraw(CTask *task, CDC *dc)
{
	I64 w = task->pix_width, h = task->pix_height;
	I64 i, id, sc, hdr, mx, my, under, tb, tmx, tmy;
	sc = HLScale(w);
	hl_sw = w;
	hl_sh = h;
	hl_ssc = sc;
	hdr = 8 * sc * 2 + 8 * (sc / 2 + 1) + 8 * sc;
	mx = mouse.pos.x - task->pix_left - task->scroll_x;
	my = mouse.pos.y - task->pix_top - task->scroll_y;
	HLRect(dc, 0, 0, w, h, WHITE);
	HLDrawHeader(dc, w, sc, hdr);
	if (hl_locked)
	{
		HLDrawPad(dc, w, h, sc, mx, my, &hl_lockpad, "ENTER PIN", hdr);
		if (hl_after)
			HLBig(dc, 4 * sc, h - 7 * sc, "ESC = CANCEL", sc / 2 + 1, DKGRAY);
		return;
	}
	under = HLTopUnder(sc, mx, my);
	tb = HLTaskHit(sc, w, h, mx, my);
	if (under || tb || hw_mode)
	{
		tmx = -9999;
		tmy = -9999;
	}
	else
	{
		tmx = mx;
		tmy = my;
	}
	HLDrawTiles(dc, 0, w, h, sc, tmx, tmy, hdr);
	HLBig(dc, 4 * sc, h - 20 * sc, "OPEN AN APP. DRAG THE TITLE TO MOVE, DRAG EDGES TO RESIZE.", sc / 2 + 1, DKGRAY);
	for (i = 0; i < hw_zn; i++)
	{
		id = hw_z[i];
		if (hw_open[id] && !hw_min[id])
			HLDrawWindow(dc, id, sc, mx, my, id == hw_z[hw_zn - 1], id == under);
	}
	HLDrawTaskbar(dc, w, h, sc, mx, my);
	if (my >= h - 3 * sc)
		hl_panel = TRUE;
	else if (my < h - 36 * sc)
		hl_panel = FALSE;
	if (hl_panel)
		HLDrawPanel(dc, w, h, sc, mx, my);
	else
		hl_pbhover = -1;
}
