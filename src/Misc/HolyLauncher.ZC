	HLAdd(2, "CLASSIC",		"", LTCYAN, CYAN, 24, 2, 2);
	HLAdd(2, "SET PIN",		"", LTGREEN, GREEN, 25, 7, 0);
	HLAdd(2, "REMOVE PIN",	"", LTRED, RED, 25, 8, 0);
}

U0 HLAskPin(I64 after)
{
	HLPadReset(&hl_lockpad);
	hl_after = after;
	hl_locked = TRUE;
}

//SPLIT
U0 HLTileAct(I64 k, I64 i)
{
	I64 kind = hl_it[k][i].kind, arg = hl_it[k][i].arg;
	if (kind == 0)
		User("%s", hl_it[k][i].cmd);
	else if (kind == 10)
		HLWinOpen(arg);
	else if (kind == 2)
	{
		HLTheme(arg);
		HLNote("Theme changed.");
	}
	else if (kind == 3)
		HLNote(hl_it[k][i].cmd);
	else if (kind == 5)
	{
		if (hl_pin[0])
			HLAskPin(1);
		else
			User;
	}
	else if (kind == 6)
	{
		if (hl_pin[0])
			HLAskPin(2);
		else
			HLWinOpen(4);
	}
	else if (kind == 7)
	{
		HLPadReset(&hl_setpad);
		hl_setmode = 1;
	}
	else if (kind == 8)
	{
		hl_pin[0] = 0;
		HLPinSave;
		HLNote("PIN removed.");
	}
}

U0 HLPanelClick(I64 i)
{
	if (i == 0)
	{
		HLTheme((hl_theme + 1) % 3);
		HLNote("Theme changed.");
	}
	else if (i == 1)
	{
		if (hl_pin[0])
			HLAskPin(0);
		else
			HLNote("Set a PIN in Settings first.");
	}
	else if (i == 2)
		Reboot;
}

U0 HLUnlockAction()
{
	if (hl_after == 1)
		User;
	else if (hl_after == 2)
		HLWinOpen(4);
	hl_after = 0;
}

U0 HLLockDigit(I64 d)
{
	HLPadAdd(&hl_lockpad, d);
	if (hl_lockpad.len == 4)
	{
		if (!StrCompare(hl_lockpad.entry, hl_pin))
		{
			hl_locked = FALSE;
			HLPadReset(&hl_lockpad);
			HLUnlockAction;
		}
		else
		{
			HLPadReset(&hl_lockpad);
			hl_lockpad.wrong = 1;
			HLNote("Wrong PIN.");
		}
	}
}

U0 HLSetDigit(I64 d)
{
	HLPadAdd(&hl_setpad, d);
	if (hl_setpad.len == 4)
	{
		StrCopy(hl_pin, hl_setpad.entry);
		HLPinSave;
		HLNote("PIN saved.");
		hl_setmode = 0;
		HLPadReset(&hl_setpad);
	}
}

U0 HLPadClick(HLPad *p, I64 setting)
{
	if (p->hover >= 0 && p->hover < 9)
	{
		if (setting)
			HLSetDigit(p->hover + 1);
		else
			HLLockDigit(p->hover + 1);
	}
	else if (p->hover == 10)
	{
		if (setting)
			HLSetDigit(0);
		else
			HLLockDigit(0);
	}
	else if (p->hover == 9)
		HLPadBack(p);
}

U0 HLContentClick(I64 id)
{
	if (id == 1)
	{
		if (hl_hov[1] >= 0)
			HLTileAct(1, hl_hov[1]);
	}
	else if (id == 2)
	{
		if (HLFMClick)
			HLWinClose(2);
	}
	else if (id == 3)
	{
		if (hl_setmode)
			HLPadClick(&hl_setpad, 1);
		else if (hl_hov[2] >= 0)
			HLTileAct(2, hl_hov[2]);
	}
	else if (id == 4)
	{
		if (hl_ihover == 0)
		{
			hl_install_req = TRUE;
			HLWinClose(4);
		}
		else if (hl_ihover == 1)
			HLWinClose(4);
	}
}

U0 HLWinButton(I64 id, I64 code)
{
	if (code == 1)
	{
		hw_min[id] = TRUE;
		HLWinRemove(id);
		HLWinTop(id);
		if (hw_zn > 1)
		{
			HLWinRemove(id);
			HLWinTop(hw_z[hw_zn - 1]);
			HLWinRemove(id);
			hw_z[hw_zn] = id;
			hw_zn++;
		}
	}
	else if (code == 2)
		HLWinMaxToggle(id);
	else if (code == 3)
		HLWinClose(id);
}

U0 HLWinResize(I64 px, I64 py)
{
	I64 id = hw_id, nx = hw_sv[id][0], ny = hw_sv[id][1], nw = hw_sv[id][2], nh = hw_sv[id][3], dx = px - hw_ex, dy = py - hw_ey, minw = 60 * hl_ssc, minh = 40 * hl_ssc;
	if (hw_edge & 1)
	{
		nx = hw_sv[id][0] + dx;
		nw = hw_sv[id][2] - dx;
		if (nw < minw)
		{
			nx -= minw - nw;
			nw = minw;
		}
	}
	if (hw_edge & 2)
	{
		nw = hw_sv[id][2] + dx;
		if (nw < minw)
			nw = minw;
	}
	if (hw_edge & 4)
	{
		ny = hw_sv[id][1] + dy;
		nh = hw_sv[id][3] - dy;
		if (nh < minh)
		{
			ny -= minh - nh;
			nh = minh;
		}
	}
	if (hw_edge & 8)
	{
		nh = hw_sv[id][3] + dy;
		if (nh < minh)
			nh = minh;
	}
	hw_x[id] = nx;
	hw_y[id] = ny;
	hw_w[id] = nw;
	hw_h[id] = nh;
}

//SPLIT
U0 HolyInstall()
{
	if (!FileFind("::/Boot/Limine-BIOS-HDD.HH"))
	{
		PopUpOk("This disc is live-only and cannot install.\nUse the HolyTempleOS.iso (BSD2-UEFI) disc to install.");
		return;
	}
	DocBottom;
	if (RunFile("::/Misc/OSInstall",, FALSE))
	{
		Del("C:/Home/DoDistro.ZC");
		Del("D:/Home/DoDistro.ZC");
		OnceDrive('C', "");
		OnceDrive('D', "");
		"\nInstall finished. Remove the disc, then press any key to reboot.\n";
		PressAKey;
		Reboot;
	}
}

U0 HolyLauncher()
{
	I64 lb_prev = FALSE, k, px, py, sc, id, t, top, w, h;
	HLTheme(0);
	HLBuildAll;
	HLPinLoad;
	HLPadReset(&hl_lockpad);
	HLPadReset(&hl_setpad);
	HLNote("Welcome to Holy TempleOS.");
	if (hl_pin[0])
	{
		hl_locked = TRUE;
		hl_after = 0;
	}
	else
		HLNote("Tip: set a PIN in Settings.");
	DocClear;
	Fs->draw_it = &HLDraw;
	while (TRUE)
	{
		w = Fs->pix_width;
		h = Fs->pix_height;
		sc = HLScale(w);
		px = mouse.pos.x - Fs->pix_left - Fs->scroll_x;
		py = mouse.pos.y - Fs->pix_top - Fs->scroll_y;
		top = 0;
		if (hw_zn > 0)
			top = hw_z[hw_zn - 1];
		if (KeyScan(&k))
		{
			if (hl_locked)
			{
				if (k >= '0' && k <= '9')
					HLLockDigit(k - '0');
				else if (k == CH_BACKSPACE)
					HLPadBack(&hl_lockpad);
				else if (k == CH_ESC && hl_after)
				{
					hl_locked = FALSE;
					hl_after = 0;
					HLPadReset(&hl_lockpad);
				}
			}
			else if (top && !hw_min[top])
			{
				if (top == 2)
				{
					if (k == CH_ESC && !fm_mode)
						HLWinClose(2);
					else
						HLFMKey(k);
				}
				else if (top == 3 && hl_setmode)
				{
					if (k >= '0' && k <= '9')
						HLSetDigit(k - '0');
					else if (k == CH_BACKSPACE)
						HLPadBack(&hl_setpad);
					else if (k == CH_ESC)
					{
						hl_setmode = 0;
						HLPadReset(&hl_setpad);
					}
				}
				else if (k == CH_ESC)
					HLWinClose(top);
			}
			else if (k == 'g')
				HLWinOpen(1);
			else if (k == 'f')
				HLWinOpen(2);
			else if (k == 's')
				HLWinOpen(3);
			else if (k == 'i')
				HLTileAct(0, 4);
		}
		if (mouse.lb && !lb_prev && !hl_locked)
		{
			hw_pbtn = 0;
			hw_pid = 0;
			t = HLTaskHit(sc, w, h, px, py);
			if (hl_panel && hl_pbhover >= 0)
			{
				hw_pbtn = 9;
				hw_pid = hl_pbhover;
			}
			else if (t)
			{
				hw_pbtn = 7;
				hw_pid = t;
			}
			else
			{
				id = HLTopUnder(sc, px, py);
				if (id)
				{
					HLWinTop(id);
					if (hw_hit >= 1 && hw_hit <= 3)
					{
						hw_pbtn = hw_hit;
						hw_pid = id;
					}
					else if (hw_hit == 4)
					{
						if (!hw_max[id])
						{
							hw_mode = 1;
							hw_id = id;
							hw_dx = px - hw_x[id];
							hw_dy = py - hw_y[id];
						}
					}
					else if (hw_hit == 6)
					{
						hw_mode = 2;
						hw_id = id;
						hw_ex = px;
						hw_ey = py;
						hw_sv[id][0] = hw_x[id];
						hw_sv[id][1] = hw_y[id];
						hw_sv[id][2] = hw_w[id];
						hw_sv[id][3] = hw_h[id];
					}
					else if (hw_hit == 5)
					{
						hw_pbtn = 5;
						hw_pid = id;
					}
				}
				else if (hl_hov[0] >= 0)
				{
					hw_pbtn = 8;
					hw_pid = hl_hov[0];
				}
			}
		}
		if (mouse.lb && hw_mode == 1)
		{
			hw_x[hw_id] = px - hw_dx;
			hw_y[hw_id] = py - hw_dy;
			if (hw_y[hw_id] < 0)
				hw_y[hw_id] = 0;
		}
		else if (mouse.lb && hw_mode == 2)
			HLWinResize(px, py);
		if (!mouse.lb && lb_prev)
		{
			if (hl_locked)
				HLPadClick(&hl_lockpad, 0);
			else if (hw_mode)
				hw_mode = 0;
			else if (hw_pbtn >= 1 && hw_pbtn <= 3)
			{
				id = HLTopUnder(sc, px, py);
				if (id == hw_pid && hw_hit == hw_pbtn)
					HLWinButton(hw_pid, hw_pbtn);
			}
			else if (hw_pbtn == 5)
				HLContentClick(hw_pid);
			else if (hw_pbtn == 7)
			{
				t = HLTaskHit(sc, w, h, px, py);
				if (t == hw_pid)
				{
					if (!hw_open[t])
						;
					else if (hw_min[t])
					{
						hw_min[t] = FALSE;
						HLWinTop(t);
					}
					else if (hw_z[hw_zn - 1] == t)
						HLWinButton(t, 1);
					else
						HLWinTop(t);
				}
			}
			else if (hw_pbtn == 8)
			{
				if (hl_hov[0] == hw_pid)
					HLTileAct(0, hw_pid);
			}
			else if (hw_pbtn == 9)
			{
				if (hl_pbhover == hw_pid)
					HLPanelClick(hw_pid);
			}
			hw_pbtn = 0;
		}
		lb_prev = mouse.lb;
		if (hl_install_req)
		{
			hl_install_req = FALSE;
			Fs->draw_it = NULL;
			DocClear;
			HolyInstall;
			DocClear;
			Fs->draw_it = &HLDraw;
		}
		Refresh;
	}
}

HolyLauncher;
